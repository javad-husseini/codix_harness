{
  "name": "codix",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "next build",
    "desktop": "electron .",
    "check:desktop": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/config.cjs",
    "test:config": "node --test tests/config.test.cjs",
    "test:backend": "python3 -m unittest discover -s tests -v",
    "test:desktop": "xvfb-run -a electron --disable-setuid-sandbox tests/desktop-smoke.cjs",
    "test:approvals": "xvfb-run -a electron --disable-setuid-sandbox tests/approval-smoke.cjs",
    "test:task": "xvfb-run -a electron --disable-setuid-sandbox tests/task-smoke.cjs",
    "test:workspace": "xvfb-run -a electron --disable-setuid-sandbox tests/workspace-smoke.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "electron": "44.9.1",
    "tailwindcss": "4.3.3"
  }
}
