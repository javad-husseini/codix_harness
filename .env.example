# Copy this file to .env. Fill in your real key locally, then restart Codix.
# Development: .env in the repository root.
# Portable Windows: .env next to Codix.exe (not inside resources).
AVALAI_API_KEY=
# Optional alternative; leave empty when using AvalAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.avalai.ir/v1
CODIX_MODEL=gpt-5.4-nano
